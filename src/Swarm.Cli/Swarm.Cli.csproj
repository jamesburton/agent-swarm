<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Swarm.Packaging.props" />

  <ItemGroup>
    <ProjectReference Include="..\Swarm.Core\Swarm.Core.csproj" />
    <ProjectReference Include="..\Swarm.Formats\Swarm.Formats.csproj" />
    <ProjectReference Include="..\Swarm.Render\Swarm.Render.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>swarm</ToolCommandName>
    <PackageId>AgentSwarm.Cli</PackageId>
    <Description>Validates swarm definitions (Markdown, YAML or C#) and renders Claude Code agent files, workflow scripts and a runbook.</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
