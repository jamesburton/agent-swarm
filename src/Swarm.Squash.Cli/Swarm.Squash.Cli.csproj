<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Swarm.Tooling.props" />
  <Import Project="..\Swarm.Packaging.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>squash</ToolCommandName>
    <PackageId>AgentSwarm.Squash</PackageId>
    <Version>0.1.0</Version>
    <Description>Lands a task branch on its epic as one trailer-stamped commit, for agent swarms.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Swarm.Git\Swarm.Git.csproj" />
    <ProjectReference Include="..\Swarm.RunState\Swarm.RunState.csproj" />
    <ProjectReference Include="..\Swarm.Batching\Swarm.Batching.csproj" />
    <ProjectReference Include="..\Swarm.Squashing\Swarm.Squashing.csproj" />
  </ItemGroup>
</Project>
